#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# The Electron executable sits inside the macOS bundle, but beside the resources directory in the
# Linux deb, tar.gz and AppImage layouts. Both names come from apps/desktop/scripts/desktop-product-identity.mjs,
# which electron-builder also reads; this static launcher cannot import it, so keep the two in sync.
if [ -x "$resources/../MacOS/Fanyu harness" ]; then
  application="$resources/../MacOS/Fanyu harness"
else
  application="$resources/../fanyu-harness"
fi
ELECTRON_RUN_AS_NODE=1 exec "$application" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
